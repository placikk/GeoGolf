{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals", "vite/client"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "scripts"]
}
